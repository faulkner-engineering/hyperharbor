<Project>
  <PropertyGroup>
    <Version>0.2.0-beta.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Company>Faulkner Engineering LLC</Company>
    <Product>HyperHarbor</Product>
    <Copyright>Copyright © 2026 Faulkner Engineering LLC</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Fail restore on known vulnerable packages, including transitive ones. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <!-- Security analyzer rules are raised to errors in .globalconfig (picked up by the SDK). -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
