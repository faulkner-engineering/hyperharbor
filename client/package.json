{
  "name": "hyperharbor-client",
  "version": "0.3.0-beta.1",
  "description": "HyperHarbor desktop client",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "gen:api": "npx --yes -p openapi-typescript@7.13.0 -p typescript@5.9 openapi-typescript ../docs/api.yaml -o ../ui/src/api/types.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@hyperharbor/ui": "file:../ui",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/three": "0.187.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
