<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HyperHarbor.Host.Core</RootNamespace>
    <AssemblyName>HyperHarbor.Host.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Contracts\Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperHarbor.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Iso9660" Version="1.0.89" />
    <PackageReference Include="LTRData.DiscUtils.Udf" Version="1.0.89" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Setup profile catalogs and schema, kept at the repository root so people can read and edit them. -->
    <EmbeddedResource Include="..\..\..\catalogs\*.yaml" LogicalName="HyperHarbor.Catalogs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\schemas\profile.v1.schema.json" LogicalName="HyperHarbor.Schemas.profile.v1.schema.json" />
    <!-- Profiles the host ships and applies itself (the Lean host action's host-gaming profile). -->
    <EmbeddedResource Include="..\..\..\profiles\*.yaml" LogicalName="HyperHarbor.Profiles.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
