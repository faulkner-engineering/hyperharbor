<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      HyperHarbor.Host.exe is the whole host: the service, the tray (with the Host.Tray library), the installer,
      and the elevated helpers. It is a Windows (GUI) executable so the tray and the installer show no console
      window; console runs attach to or open a console themselves (ConsoleAttachment).
    -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>HyperHarbor.Host.Service</RootNamespace>
    <AssemblyName>HyperHarbor.Host</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Packages' XML documentation (WebView2's) would land beside the single executable. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms names (Timer, Application, Control) would clash with the web and threading namespaces. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Host.Core\Host.Core.csproj" />
    <ProjectReference Include="..\Host.Tray\Host.Tray.csproj" />
    <ProjectReference Include="..\Shared.Contracts\Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single executable carries its default settings; an appsettings.json beside it still overrides them. -->
    <EmbeddedResource Include="appsettings.json" LogicalName="HyperHarbor.Host.appsettings.json" />
    <Content Update="appsettings.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
    <EmbeddedResource Include="Wake\Diagnose-Wake.ps1" LogicalName="HyperHarbor.Host.Diagnose-Wake.ps1" />
    <!--
      Kopia, the backup engine. package.ps1 downloads the pinned release (scripts/fetch-tools.ps1) and passes its path
      as KopiaExe; development builds have no payload and use HH_KOPIA_EXE instead. tools.json holds the pinned hashes.
    -->
    <EmbeddedResource Include="$(KopiaExe)" LogicalName="HyperHarbor.Host.tools.kopia.exe" Condition="'$(KopiaExe)' != '' And Exists('$(KopiaExe)')" />
    <EmbeddedResource Include="..\..\..\tools\tools.json" LogicalName="HyperHarbor.Host.tools.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperHarbor.Host.Tests" />
  </ItemGroup>

</Project>
