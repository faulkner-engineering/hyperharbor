<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Linked into HyperHarbor.Host.exe, which runs the tray in its tray mode (TrayApp). -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HyperHarbor.Host.Tray</RootNamespace>
    <AssemblyName>HyperHarbor.Host.Tray</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Notification area icons from hyperharbor-brand/icons; TrayIconProvider loads them by these names. -->
    <EmbeddedResource Include="Resources\tray-*.ico" LogicalName="HyperHarbor.Host.Tray.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Contracts\Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperHarbor.Host.Tests" />
  </ItemGroup>

</Project>
