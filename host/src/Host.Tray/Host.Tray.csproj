<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Linked into HyperHarbor.Host.exe, which runs the tray in its tray mode (TrayApp). -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>HyperHarbor.Host.Tray</RootNamespace>
    <AssemblyName>HyperHarbor.Host.Tray</AssemblyName>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- The window's HTML app has its own build (webui/, npm); none of its files are items of this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);webui\**</DefaultItemExcludes>
    <TrayUiDirectory>$(MSBuildProjectDirectory)\webui</TrayUiDirectory>
    <!-- The components the window shares with the client (@hyperharbor/ui; docs/host-vm-management.md). -->
    <SharedUiDirectory>$(MSBuildProjectDirectory)\..\..\..\ui</SharedUiDirectory>
  </PropertyGroup>

  <ItemGroup>
    <!-- Notification area icons from hyperharbor-brand/icons; TrayIconProvider loads them by these names. -->
    <EmbeddedResource Include="Resources\tray-*.ico" LogicalName="HyperHarbor.Host.Tray.Resources.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.Contracts\Shared.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HyperHarbor.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- What the UI build reads; a change to any of them builds it again. -->
  <ItemGroup>
    <TrayUiInput Include="$(TrayUiDirectory)\src\**\*" />
    <TrayUiInput Include="$(TrayUiDirectory)\index.html;$(TrayUiDirectory)\package.json;$(TrayUiDirectory)\package-lock.json;$(TrayUiDirectory)\vite.config.ts" />
    <TrayUiInput Include="$(SharedUiDirectory)\src\**\*;$(SharedUiDirectory)\package.json" />
  </ItemGroup>

  <!-- Installs the UI's packages once (npm ci), the shared components' first: the window links to them. -->
  <Target Name="RestoreSharedUi" Condition="!Exists('$(SharedUiDirectory)\node_modules')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(SharedUiDirectory)" />
  </Target>

  <Target Name="RestoreTrayUi" Condition="!Exists('$(TrayUiDirectory)\node_modules')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(TrayUiDirectory)" />
  </Target>

  <!-- Builds the UI into webui\dist when its sources changed. -->
  <Target Name="BuildTrayUi" DependsOnTargets="RestoreSharedUi;RestoreTrayUi" Inputs="@(TrayUiInput)" Outputs="$(TrayUiDirectory)\dist\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(TrayUiDirectory)" />
  </Target>

  <!-- Embeds every file of webui\dist as HyperHarbor.Tray.Ui/<path>, which TrayUiResources serves to WebView2. The
       items are added here, after the build, because webui\dist does not exist when the project is first evaluated. -->
  <Target Name="EmbedTrayUi" BeforeTargets="BeforeBuild" DependsOnTargets="BuildTrayUi">
    <ItemGroup>
      <TrayUiFile Include="$(TrayUiDirectory)\dist\**\*" />
      <EmbeddedResource Include="@(TrayUiFile)" LogicalName="HyperHarbor.Tray.Ui/$([System.String]::Copy('%(RecursiveDir)%(Filename)%(Extension)').Replace('\', '/'))" />
    </ItemGroup>
  </Target>

</Project>
